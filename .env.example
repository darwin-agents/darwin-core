# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=darwin-core
OPENROUTER_WEB_MAX_STEPS=12
OPENROUTER_WEB_ARTIFACTS_DIR=artifacts/openrouter-web-agent

# darwin_web (isolated agent; uses same OpenRouter + Browser Use server)
DARWIN_WEB_MAX_STEPS=16
# Ranked email providers for signup goals (easiest → hardest): config/emails.json
# DARWIN_WEB2_EMAILS_CONFIG=config/emails.json

# Long multi-page flows (e.g. Google signup + verification) often need 40–64+ turns.
DARWIN_WEB_PLAYBOOK_OUT=artifacts/darwin-web/playbook.yaml
DARWIN_WEB_ARTIFACTS_DIR=artifacts/darwin-web
# (under that dir: *-vision-input.png, *-llm-turn.yaml merged prompt/response/planner, playbook.yaml if different from DARWIN_WEB_PLAYBOOK_OUT)
# DARWIN_WEB_VISION=1   # 0 to disable attaching screenshot to the planner LLM
# After each click / pick_option / press (with ref), wait this many ms so SPAs update before the next snapshot (default 1000).
# DARWIN_WEB_POST_CLICK_MS=1000

# darwin_web2 (observe → verify loop, playbook v2)
# DARWIN_WEB2_MAX_STEPS=32
# DARWIN_WEB2_PLAYBOOK_OUT=artifacts/darwin-web2/playbook.yaml
# DARWIN_WEB2_ARTIFACTS_DIR=artifacts/darwin-web2
# (under that dir: *-vision-input.png, *-dom-input.yaml, *-llm-turn-v2.yaml)
# DARWIN_WEB2_VISION=1
# DARWIN_WEB2_REFLECT=1   # second LLM pass after verify failure (same OpenRouter key)
# DARWIN_WEB2_ACCOUNTS_PATH=artifacts/darwin-web2/accounts.jsonl
# DOM extraction sent to the planner + saved in *-dom-input.yaml for debugging:
# DARWIN_WEB2_DOM_ARIA=1              # include Playwright accessibility tree in planner prompt (default on)
# DARWIN_WEB2_DOM_FORM_HTML=0         # include scoped form HTML in planner prompt (default off; always in dom-input artifact)
# DARWIN_WEB2_SNAPSHOT_PROMPT_ITEMS=128
# DARWIN_WEB2_SNAPSHOT_ARTIFACT_ITEMS=512   # full interactive list in dom-input.yaml
# DARWIN_WEB2_ARIA_SNAPSHOT_MAX_CHARS=16000
# DARWIN_WEB2_FORM_HTML_MAX_CHARS=12000

# darwin_web human-in-the-loop (Telegram): planner can return {"op":"request_human",...}
# DARWIN_WEB_TELEGRAM_BOT_TOKEN=
# DARWIN_WEB_TELEGRAM_CHAT_ID=
# DARWIN_WEB_TELEGRAM_MAX_WAIT_S=3600
# Any text reply ends HIL wait and is shown to the planner next turn. Set to 1 to require /continue-style commands only:
# DARWIN_WEB_TELEGRAM_STRICT_CONTINUE=0
# Optional: decode QR in HIL screenshot and send the HTTP link in Telegram (needs: uv sync --extra telegram_qr)
# DARWIN_WEB_DECODE_QR=0

# Browser Use Cloud
BROWSER_USE_API_KEY=bu_your_key_here
BROWSER_USE_PROFILE_ID=
# Browser Use Cloud egress / proxy region (ISO 3166-1 alpha-2, lowercase). Example: es = Spain.
BROWSER_USE_PROXY_COUNTRY_CODE=es
# Optional API base (default https://api.browser-use.com/api/v3)
# BROWSER_USE_API_BASE_URL=https://api.browser-use.com/api/v3
BROWSER_USE_SERVER_URL=http://localhost:8000

# Local server config
HOST=0.0.0.0
PORT=8000
