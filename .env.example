# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=darwin-core
OPENROUTER_WEB_MAX_STEPS=12
OPENROUTER_WEB_ARTIFACTS_DIR=artifacts/openrouter-web-agent

# darwin_web (isolated agent; uses same OpenRouter + Browser Use server)
DARWIN_WEB_MAX_STEPS=16
# Long multi-page flows (e.g. Google signup + verification) often need 40–64+ turns.
DARWIN_WEB_PLAYBOOK_OUT=artifacts/darwin-web/playbook.yaml
DARWIN_WEB_ARTIFACTS_DIR=artifacts/darwin-web
# (under that dir: *-step.png, *-vision-input.png, *-llm-turn.yaml merged prompt/response/planner, playbook.yaml if different from DARWIN_WEB_PLAYBOOK_OUT)
# DARWIN_WEB_VISION=1   # 0 to disable attaching screenshot to the planner LLM

# darwin_web human-in-the-loop (Telegram): planner can return {"op":"request_human",...}
# DARWIN_WEB_TELEGRAM_HIL=1
# DARWIN_WEB_TELEGRAM_BOT_TOKEN=
# DARWIN_WEB_TELEGRAM_CHAT_ID=
# DARWIN_WEB_TELEGRAM_MAX_WAIT_S=3600

# Browser Use Cloud
BROWSER_USE_API_KEY=bu_your_key_here
BROWSER_USE_PROFILE_ID=
BROWSER_USE_PROXY_COUNTRY_CODE=us
BROWSER_USE_CONNECT_BASE_URL=wss://connect.browser-use.com
BROWSER_USE_SERVER_URL=http://localhost:8000

# Local server config
HOST=0.0.0.0
PORT=8000
