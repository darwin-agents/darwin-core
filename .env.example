# OpenRouter
# ---------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=darwin-core

# Browser Use Cloud
# ---------------------------------------------------------
BROWSER_USE_API_KEY=bu_your_key_here
BROWSER_USE_PROFILE_ID=
# Browser Use Cloud egress / proxy region (ISO 3166-1 alpha-2, lowercase). Example: es = Spain.
BROWSER_USE_PROXY_COUNTRY_CODE=es
# Optional API base (default https://api.browser-use.com/api/v3)
BROWSER_USE_API_BASE_URL=https://api.browser-use.com/api/v3
# On 429 (free plan: 3 concurrent browsers), stop active sessions and retry (default on)
BROWSER_USE_AUTO_RELEASE_SESSIONS=1
BROWSER_USE_SERVER_URL=http://localhost:8000
# Optional clickable link in Telegram HIL when a session may be orphaned
# BROWSER_USE_CLOUD_DASHBOARD_URL=

# Local server config
HOST=0.0.0.0
PORT=8000


# Darwin Web Agent
# ---------------------------------------------------------
DARWIN_WEB_MAX_STEPS=32
DARWIN_WEB_PLAYBOOK_OUT=artifacts/darwin-web/playbook.yaml
DARWIN_WEB_ARTIFACTS_DIR=artifacts/darwin-web
# (under that dir: *-vision-input.png, *-dom-input.yaml, *-llm-turn.yaml)

# Enable/disable vision support (attach screenshots to planner LLM)
DARWIN_WEB_VISION=1
# Second LLM pass to self-correct after a verification failure
DARWIN_WEB_REFLECT=1
# Ranked email providers for signup goals (easiest → hardest)
DARWIN_WEB_EMAILS_CONFIG=config/emails.json
# File to append newly created account credentials
DARWIN_WEB_ACCOUNTS_PATH=artifacts/darwin-web/accounts.jsonl

# DOM extraction sent to the planner + saved in *-dom-input.yaml for debugging:
DARWIN_WEB_DOM_ARIA=1              # include Playwright accessibility tree in planner prompt (default on)
DARWIN_WEB_DOM_FORM_HTML=0         # include scoped form HTML in planner prompt (default off; always in dom-input artifact)
DARWIN_WEB_SNAPSHOT_PROMPT_ITEMS=128
DARWIN_WEB_SNAPSHOT_ARTIFACT_ITEMS=512   # full interactive list in dom-input.yaml
DARWIN_WEB_ARIA_SNAPSHOT_MAX_CHARS=16000
DARWIN_WEB_FORM_HTML_MAX_CHARS=12000

# POST /browser/release before agent connect (avoids free-plan 3-session wall after crash; default on)
DARWIN_WEB_RELEASE_ON_START=1
# Layout-unchanged steps on registration URLs before auto-goto next emails.json provider
DARWIN_WEB_PROVIDER_ADVANCE_STEPS=5
# Shorter random username local-parts for signup ($GENHASH), clamped 8–12 (default 10)
DARWIN_WEB_GENHASH_USERNAME_LENGTH=10
# After each click / pick_option / press (with ref), wait this many ms so SPAs update before the next snapshot (default 1000).
DARWIN_WEB_POST_CLICK_MS=1000


# Darwin Web Human-in-the-loop (Telegram)
# ---------------------------------------------------------
# The planner can return {"op":"request_human",...} to ask for help on captchas or OTPs.
DARWIN_WEB_TELEGRAM_HIL=1
DARWIN_WEB_TELEGRAM_BOT_TOKEN=
DARWIN_WEB_TELEGRAM_CHAT_ID=
DARWIN_WEB_TELEGRAM_MAX_WAIT_S=3600
# Any text reply ends HIL wait and is shown to the planner next turn. Set to 1 to require /continue-style commands only:
DARWIN_WEB_TELEGRAM_STRICT_CONTINUE=0
# Optional: decode QR in HIL screenshot and send the HTTP link in Telegram (needs: uv sync --extra telegram_qr)
DARWIN_WEB_DECODE_QR=0
